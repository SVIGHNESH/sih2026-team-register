# Local Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:55432/sih2026

# Neon (Console -> Connection Details -> Pooled connection).
# The pooled host is the one that works from both a server and a serverless function.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

PORT=3000

# Leave unset and the register is fully open, which is right on a laptop.
# Set it before putting the app on a public URL: reading stays open to
# everyone, and every change asks for this passcode.
# ADMIN_PASSWORD=
# SESSION_SECRET=
