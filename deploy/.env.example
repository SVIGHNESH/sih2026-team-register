# Copy to deploy/.env on the server. Nothing here belongs in git.

# The domain pointing at this instance. Caddy needs a real name to get a
# certificate; an ec2-*.compute.amazonaws.com address will not work, because
# Let's Encrypt does not issue for it.
DOMAIN=register.example.edu

# Database. Generate the password, do not invent one:
#   openssl rand -base64 24
POSTGRES_USER=sih
POSTGRES_DB=sih2026
POSTGRES_PASSWORD=

# The coordinator passcode. Anyone can read the register; only someone with
# this can change it.
ADMIN_PASSWORD=

# Keeps sign-ins valid across a redeploy:
#   openssl rand -hex 32
SESSION_SECRET=
